OPENROUTER_API_KEY=
GEMINI_API_KEY=
EDITH_MODEL=gemini-3.5-flash
# Shared-secret auth for the hosted API (server.py) — required for the web UI/Android
# app (and now /api/observability/*) to authenticate. Any random string; generate one
# with e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"` and paste
# the same value into the web/Android app's token prompt.
EDITH_API_TOKEN=
# Optional — semantic memory (edith/memory/vectors.py). App runs fine without these,
# just without semantic recall.
QDRANT_URL=
QDRANT_API_KEY=
# Optional — Temporal Cloud, backs schedule_job and the nightly reflection job. App
# runs fine without these; only `python -m edith.temporal.worker` and schedule_job need them.
# TEMPORAL_ADDRESS looks like "your-namespace.a1b2c.tmprl.cloud:7233"
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Optional — cron used when nightly reflection is turned on (ask Edith to
# enable_nightly_reflection; it's opt-in, not automatic). Default 3am local to the worker host.
EDITH_NIGHTLY_REFLECTION_CRON=
# Optional — Firebase Cloud Messaging, backs push notifications to the edith-android app
# (job completions, alarms). App runs fine without this, just no push. Paste the raw JSON
# of a Firebase service account key (Firebase Console > Project Settings > Service Accounts
# > Generate new private key) as a single-line value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional — Hunter.io, backs domain search / email finder / verifier / company & person
# enrichment for lead-gen and outreach. App runs fine without this; the hunter_* tools just
# report they're not configured. Get a key at hunter.io > API (dashboard shows keys masked —
# click one or "New key" to see/copy the real value).
HUNTER_API_KEY=
# Optional — Situation Monitor dashboard tab (edith/monitor/). Each is independent; a
# missing one just shows "not connected" on its own panel, nothing else breaks.
# Dodo Payments (Revenue panel): API key from your Dodo dashboard > Developer > API Keys.
DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_BASE_URL= (defaults to https://live.dodopayments.com; set to
# https://test.dodopayments.com to point the panel at test-mode data instead)
# Vercel Analytics (Analytics panel): token needs the "Web Analytics" scope. Create one at
# vercel.com/account/tokens. VERCEL_TEAM_ID is only needed if your projects live under a team.
# Which project(s) show up is set separately, via track_vercel_project (chat) or the panel's
# "Track" form, not here — supports tracking more than one app at once.
VERCEL_ANALYTICS_TOKEN=
VERCEL_TEAM_ID=
# GitHub (Shipping Log panel): only needed for private repos — public repos work with no
# token. Fine-grained token with read-only "Contents" access is enough. Which repos show up
# is set separately, via track_shipping_repo (chat) or the panel's "Track" form, not here.
GITHUB_TOKEN=
# Optional — autonomous job-application pipeline (edith/tools/job_applications.py). Ask Edith
# to enable_jobs_pipeline to turn it on; it's opt-in, not automatic. Cron fires several times
# across Bengaluru working hours by default so sends trickle through the day instead of
# bursting all at once.
EDITH_JOB_SEARCH_CRON=
EDITH_JOB_SEARCH_LEADS_PER_RUN=
EDITH_JOBS_DAILY_CAP=
# LinkedIn Growth Engine — best grower agent (Phase 2)
# Text: cheapest Qwen via OpenRouter ($0.03/$0.13 per 1M) — qwen/qwen3.7-flash
LINKEDIN_TEXT_MODEL=qwen/qwen3.7-flash
LINKEDIN_FALLBACK_TEXT_MODEL=qwen/qwen3.5-flash-02-23
# Image: cheapest flat rate — meta/muse-image $0.01/image, fallback gemini flash lite
LINKEDIN_IMAGE_MODEL=meta/muse-image
LINKEDIN_FALLBACK_IMAGE_MODEL=google/gemini-2.5-flash-image
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_VERSION=202607
# pgvector memory (Phase 2): set DATABASE_URL to enable (e.g. postgres://user:pass@host:5432/edith)
# If unset, falls back to Qdrant/no-op same as core memory. Works with Railway Postgres.
DATABASE_URL=
PGVECTOR_ENABLED=true
# Optional, local machine only — computer_use/open_in_browser tools (edith/computer_use/,
# edith/tools/computer_use.py). Makes no sense on the hosted Railway server (no display, no
# Brave, no Accessibility) — the tools just report "not configured" without these. Both the
# Jev decisions and the writer's free-text composition go through OpenRouter — reuses
# OPENROUTER_API_KEY above, no separate account. Writer model defaults to qwen/qwen3.7-flash
# — override with EDITH_COMPUTER_USE_WRITER_MODEL. The only manual step left is granting
# Accessibility (System Settings > Privacy & Security > Accessibility) to whatever process
# runs the edith server/CLI.
# VERCEL_AI_GATEWAY_BASE_URL= (defaults to https://ai-gateway.vercel.sh/v1)
# EDITH_COMPUTER_USE_MODEL= (defaults to openai/gpt-4o-mini — pick any JSON-mode-capable
# model slug listed in your gateway dashboard)
