# =============================================================================
# Eddy configuration. Copy to .env:   cp .env.example .env
# Only OPENROUTER_API_KEY is required. Everything else switches on a feature.
# =============================================================================

# --- Required ----------------------------------------------------------------
# Chat model, Eddy's memory (brain + embeddings), voice, and web search fallback.
# Get a key at openrouter.ai/keys.
OPENROUTER_API_KEY=

# Shared secret for the web UI, desktop notch, and Android app. Any random string:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EDITH_API_TOKEN=

# --- Models (optional overrides) ---------------------------------------------
# EDITH_MODEL=qwen/qwen3.7-flash            # main chat/tool-calling model
# EDITH_MEMORY_MODEL=qwen/qwen3.7-flash     # the brain: files, links and evolves memories

# --- Vector DB (Qdrant) -------------------------------------------------------
# docker compose runs one for you. To use your own (Qdrant Cloud or self-hosted),
# set the URL (+ API key for Cloud). With neither, a local install keeps an
# embedded on-disk Qdrant at QDRANT_PATH (default ~/.edith/qdrant).
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_PATH=

# --- Scheduler (Temporal) — reminders, recurring jobs, nightly reflection -----
# Local:  docker compose --profile scheduler up -d   and set TEMPORAL_ADDRESS=temporal:7233
# Cloud:  your Temporal Cloud address + namespace + API key.
# Leave empty and Eddy works fine, just without scheduled jobs.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Cron for nightly reflection once you ask Eddy to enable it (opt-in). Default 3am worker-local.
EDITH_NIGHTLY_REFLECTION_CRON=

# --- Better web search (optional) ---------------------------------------------
# Upgrades web_search / news / research to Google Search grounding. Without it,
# search runs through OpenRouter's web plugin.
GEMINI_API_KEY=

# --- Integrations (each optional, each independent) ---------------------------
# Google (Gmail/Drive/Calendar/Docs): put an OAuth "Desktop app" client secret at
# ~/.edith/google_client_secret.json, then run /google login in the CLI.

# Push notifications to the Android app: raw Firebase service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# GitHub — private repos for github_* tools and the Monitor tab's shipping log.
# Fine-grained token with read-only Contents is enough. Public repos need no token.
GITHUB_TOKEN=

# Monitor tab panels: Dodo Payments revenue, Vercel analytics.
DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
VERCEL_ANALYTICS_TOKEN=
VERCEL_TEAM_ID=

# Monid (structured web/social data tools). The Docker image re-authenticates from this on start.
MONID_API_KEY=

# Mac control (operate_mac / look_at_screen) — local machine only, needs Accessibility
# permission for the process running Eddy. Uses OPENROUTER_API_KEY; no extra key.
# EDITH_COMPUTER_USE_WRITER_MODEL=qwen/qwen3.7-flash

# =============================================================================
# Plugins — opt-in feature packs, comma-separated.
#   career = job-application pipeline, startup finder + cold email, founder
#            outreach, Hunter email lookup, LinkedIn/X content planner.
# =============================================================================
EDITH_PLUGINS=

# --- career plugin -------------------------------------------------------------
# Your details live in a profile file, not in code. Start from
# edith/plugins/career/career_profile.example.json and save it here:
# EDITH_CAREER_PROFILE=~/.edith/career_profile.json
# Resume PDF attached to cold emails / used for drafting (also: scripts/ingest_resume.py).
EDITH_RESUME_PDF=
# Lead sourcing + enrichment.
HUNTER_API_KEY=
CRUSTDATA_API_KEY=
APOLLO_API_KEY=
PROSPEO_API_KEY=
# EDITH_STARTUP_FINDER_MODEL=
# EDITH_STARTUP_FINDER_FALLBACK_MODEL=
# Job pipeline (ask Eddy to enable_jobs_pipeline; opt-in). Cron fires several times
# a day so sends trickle out instead of bursting.
# EDITH_JOB_SEARCH_CRON=30 4-13 * * 1-5
# EDITH_JOB_SEARCH_LEADS_PER_RUN=3
# EDITH_JOBS_DAILY_CAP=25
# LinkedIn / X content planner.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# LINKEDIN_VERSION=202607
# LINKEDIN_TEXT_MODEL=qwen/qwen3.7-flash
# LINKEDIN_IMAGE_MODEL=meta/muse-image
# GitHub repos for the weekly "what shipped" digest (else the profile's github_repos).
# GITHUB_DIGEST_REPOS=owner/repo,owner/other
# Optional Postgres + pgvector for persona memory (falls back to no-op without it).
DATABASE_URL=
PGVECTOR_ENABLED=true
