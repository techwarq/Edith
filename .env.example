OPENROUTER_API_KEY=
GEMINI_API_KEY=
EDITH_MODEL=gemini-3.5-flash
# Shared-secret auth for the hosted API (server.py) — required for the web UI/Android
# app (and now /api/observability/*) to authenticate. Any random string; generate one
# with e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"` and paste
# the same value into the web/Android app's token prompt.
EDITH_API_TOKEN=
# Optional — semantic memory (edith/memory/vectors.py). App runs fine without these,
# just without semantic recall.
QDRANT_URL=
QDRANT_API_KEY=
# Optional — Temporal Cloud, backs schedule_job and the nightly reflection job. App
# runs fine without these; only `python -m edith.temporal.worker` and schedule_job need them.
# TEMPORAL_ADDRESS looks like "your-namespace.a1b2c.tmprl.cloud:7233"
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Optional — cron used when nightly reflection is turned on (ask Edith to
# enable_nightly_reflection; it's opt-in, not automatic). Default 3am local to the worker host.
EDITH_NIGHTLY_REFLECTION_CRON=
# Optional — Firebase Cloud Messaging, backs push notifications to the edith-android app
# (job completions, alarms). App runs fine without this, just no push. Paste the raw JSON
# of a Firebase service account key (Firebase Console > Project Settings > Service Accounts
# > Generate new private key) as a single-line value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional — Hunter.io, backs domain search / email finder / verifier / company & person
# enrichment for lead-gen and outreach. App runs fine without this; the hunter_* tools just
# report they're not configured. Get a key at hunter.io > API (dashboard shows keys masked —
# click one or "New key" to see/copy the real value).
HUNTER_API_KEY=
